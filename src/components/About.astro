---
import { site } from '../content/site';
import { asset } from '../lib/asset';
const { about } = site;
---

<section id="about" class="about section" aria-labelledby="about-title">
  <div class="wrap about-grid">
    <figure class="about-figure reveal">
      <img
        src={asset(about.image.src)}
        alt={about.image.alt}
        width="900"
        height="1100"
        loading="lazy"
        decoding="async"
      />
    </figure>

    <div class="about-copy reveal">
      <span class="eyebrow">נעים להכיר</span>
      <h2 id="about-title" class="section-heading">{about.heading}</h2>
      <p class="about-lead">{about.lead}</p>
      {about.paragraphs.map((p) => <p class="about-para">{p}</p>)}
    </div>
  </div>
</section>

<style>
  .about { background: var(--ivory-soft); }
  .about-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 1rem + 5vw, 4.5rem);
    align-items: center;
  }
  .about-figure { margin: 0; }
  .about-figure img {
    width: 100%;
    aspect-ratio: 5 / 6;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
  }
  .about-lead {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.4;
    color: var(--ink);
    margin: 1rem 0 1.4rem;
  }
  .about-para { color: var(--ink-soft); margin-bottom: 1rem; max-width: 60ch; }
  .about-para:last-child { margin-bottom: 0; }

  @media (max-width: 820px) {
    .about-grid { grid-template-columns: 1fr; }
    .about-figure { max-width: 420px; }
  }
</style>
