---
import { site } from '../content/site';
import { asset } from '../lib/asset';
const { about } = site;
---

<section id="about" class="about section" aria-labelledby="about-title">
  <div class="wrap about-grid">
    <figure class="about-figure reveal">
      <img
        src={asset(about.image.src)}
        alt={about.image.alt}
        width="1000"
        height="1200"
        loading="lazy"
        decoding="async"
      />
    </figure>

    <div class="about-copy reveal">
      <h2 id="about-title" class="section-heading">{about.heading}</h2>
      <p class="about-lead">{about.lead}</p>
      {about.paragraphs.map((p) => <p class="about-para">{p}</p>)}

      <div class="about-cred">
        <h3 class="about-cred-title">{about.credentialsHeading}</h3>
        <ul class="about-cred-list">
          {about.credentials.map((c) => (
            <li class="cred-item">
              <p class="cred-title">{c.title}</p>
              <p class="cred-issuer">{c.issuer}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .about { background: var(--ivory-soft); }
  .about-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(2rem, 1rem + 5vw, 4.5rem);
    align-items: start;
  }
  .about-figure { margin: 0; position: sticky; top: 6rem; }
  .about-figure img {
    width: 100%;
    aspect-ratio: 5 / 6;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
  }
  .about-lead {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.4;
    color: var(--ink);
    margin: 0.9rem 0 1.3rem;
  }
  .about-para { color: var(--ink-soft); margin-bottom: 1rem; max-width: 62ch; }

  .about-cred {
    margin-top: 1.8rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--line);
  }
  .about-cred-title {
    font-size: var(--step-0);
    font-weight: 700;
    color: var(--olive-deep);
    margin-bottom: 1rem;
    letter-spacing: 0.01em;
  }
  .about-cred-list { display: grid; gap: 1rem; }
  .cred-item {
    padding-inline-start: 1rem;
    border-inline-start: 2px solid var(--olive);
  }
  .cred-title {
    font-weight: 500;
    color: var(--ink);
    font-size: var(--step-0);
    line-height: 1.45;
  }
  .cred-issuer {
    margin-top: 0.2rem;
    color: var(--ink-mute);
    font-size: var(--step--1);
  }

  @media (max-width: 820px) {
    .about-grid { grid-template-columns: 1fr; }
    .about-figure { position: static; max-width: 420px; }
  }
</style>
