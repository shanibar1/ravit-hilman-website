---
import { site } from '../content/site';
const { audience } = site;
---

<section id="audience" class="audience section" aria-labelledby="audience-title">
  <div class="wrap audience-grid">
    <div class="audience-head reveal">
      <h2 id="audience-title" class="section-heading">{audience.heading}</h2>
      <p class="section-lead">{audience.lead}</p>

      <div class="audience-areas">
        <h3 class="audience-areas-title">{audience.areasHeading}</h3>
        <ul class="area-tags">
          {audience.areas.map((a) => <li class="area-tag">{a}</li>)}
        </ul>
      </div>
    </div>

    <ul class="audience-list">
      {audience.groups.map((g) => (
        <li class="audience-item reveal">
          <h3 class="audience-item-title">{g.title}</h3>
          <p class="audience-item-body">{g.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .audience-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 1rem + 5vw, 5rem);
    align-items: start;
  }
  .audience-head { position: sticky; top: 6rem; }

  .audience-areas {
    margin-top: clamp(1.8rem, 1.2rem + 2vw, 2.6rem);
    padding-top: clamp(1.4rem, 1rem + 1.5vw, 2rem);
    border-top: 1px solid var(--line);
  }
  .audience-areas-title {
    font-size: var(--step-0);
    font-weight: 700;
    color: var(--olive-deep);
    margin-bottom: 1rem;
  }
  .area-tags { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .area-tag {
    background: var(--white);
    border: 1px solid var(--line);
    color: var(--ink-soft);
    border-radius: 999px;
    padding: 0.5rem 1rem;
    font-size: var(--step--1);
    font-weight: 500;
  }

  .audience-list { display: grid; gap: 0; }
  .audience-item {
    padding: clamp(1.4rem, 1rem + 1.5vw, 2rem) 0;
    border-top: 1px solid var(--line);
    position: relative;
    padding-inline-start: 1.6rem;
  }
  .audience-item:first-child { border-top: 0; padding-top: 0; }
  .audience-item:first-child::before { top: 0.5rem; }
  .audience-item::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: calc(clamp(1.4rem, 1rem + 1.5vw, 2rem) + 0.55rem);
    width: 0.6rem; height: 0.6rem;
    border-radius: 50%;
    background: var(--olive);
  }
  .audience-item-title {
    font-size: var(--step-2);
    margin-bottom: 0.4rem;
    color: var(--ink);
  }
  .audience-item-body { color: var(--ink-soft); max-width: 54ch; }

  @media (max-width: 820px) {
    .audience-grid { grid-template-columns: 1fr; }
    .audience-head { position: static; }
  }
</style>
