---
import { site } from '../content/site';
const { process } = site;
---

<section id="process" class="process section" aria-labelledby="process-title">
  <div class="wrap process-grid">
    <div class="process-head reveal">
      <h2 id="process-title" class="section-heading">{process.heading}</h2>
      <p class="section-lead">{process.lead}</p>
      <p class="process-note">{process.note}</p>
    </div>

    <ol class="process-steps">
      {process.steps.map((s, i) => (
        <li class="process-step reveal" style={`transition-delay:${i * 100}ms`}>
          <span class="process-num" aria-hidden="true">{i + 1}</span>
          <div class="process-step-body">
            <h3 class="process-step-title">{s.title}</h3>
            <p>{s.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process { background: var(--clay); }
  .process-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(2rem, 1rem + 5vw, 5rem);
    align-items: start;
  }
  .process-head { position: sticky; top: 6rem; }
  .process-note {
    margin-top: 1.4rem;
    font-size: var(--step--1);
    color: var(--ink-mute);
    background: var(--ivory-soft);
    border-inline-start: 3px solid var(--olive);
    padding: 0.9rem 1.1rem;
    border-radius: 10px;
  }

  /* Typographic step list — dividers, not boxes */
  .process-steps { display: grid; }
  .process-step {
    display: flex;
    gap: clamp(1rem, 0.5rem + 1.6vw, 1.8rem);
    align-items: baseline;
    padding-block: clamp(1.3rem, 1rem + 1vw, 1.9rem);
    border-top: 1px solid var(--line);
  }
  .process-step:first-child { border-top: 0; padding-top: 0; }
  .process-num {
    flex: 0 0 auto;
    font-size: var(--step-2);
    font-weight: 800;
    line-height: 1;
    color: var(--olive);
    font-variant-numeric: tabular-nums;
    min-width: 1.6ch;
  }
  .process-step-title { font-size: var(--step-1); margin-bottom: 0.3rem; }
  .process-step-body p { color: var(--ink-soft); }

  @media (max-width: 820px) {
    .process-grid { grid-template-columns: 1fr; }
    .process-head { position: static; }
  }
</style>
