---
import { site } from '../content/site';
import { asset } from '../lib/asset';
const { hero } = site;
---

<section id="top" class="hero section" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <span class="eyebrow">{hero.eyebrow}</span>
      <h1 id="hero-title" class="hero-title">
        <span class="hero-line">{hero.headlineTop}</span>
        <span class="hero-line hero-line--accent">{hero.headlineAccent}</span>
      </h1>
      <p class="hero-intro">{hero.intro}</p>

      <ul class="hero-meta">
        {hero.meta.map((item) => <li>{item}</li>)}
      </ul>

      <div class="hero-actions">
        <a class="btn btn-primary btn-lg" href={hero.ctaHref}>{hero.ctaLabel}</a>
      </div>
    </div>

    <figure class="hero-figure">
      <img
        src={asset(hero.image.src)}
        alt={hero.image.alt}
        width="1000"
        height="1250"
        fetchpriority="high"
        decoding="async"
      />
      <span class="hero-figure-frame" aria-hidden="true"></span>
    </figure>
  </div>
</section>

<style>
  .hero { padding-top: clamp(2.5rem, 1.5rem + 4vw, 5rem); }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.02fr 0.98fr;
    align-items: center;
    gap: clamp(2rem, 1rem + 5vw, 5.5rem);
  }
  .hero-title {
    font-size: var(--step-4);
    font-weight: 700;
    line-height: 1.08;
    margin: 1.1rem 0 1.4rem;
  }
  .hero-line { display: block; }
  .hero-line--accent { color: var(--olive-deep); }
  .hero-intro {
    font-size: var(--step-1);
    color: var(--ink-soft);
    max-width: 46ch;
    line-height: 1.7;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.65rem;
    margin-top: 1.5rem;
  }
  .hero-meta li {
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--olive-deep);
    background: var(--olive-tint);
    border-radius: 999px;
    padding: 0.4rem 0.9rem;
  }

  .hero-actions { margin-top: 2rem; }

  .hero-figure { position: relative; margin: 0; }
  .hero-figure img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    position: relative;
    z-index: 2;
  }
  .hero-figure-frame {
    position: absolute;
    inset-block: 1.6rem -1.6rem;
    inset-inline-start: -1.6rem;
    inset-inline-end: 1.6rem;
    border: 1.5px solid var(--olive);
    border-radius: var(--radius-lg);
    z-index: 1;
  }

  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-figure { order: -1; max-width: 440px; margin-inline: auto; }
    .hero-figure-frame { display: none; }
    .hero-title { margin-top: 0.8rem; }
    .hero-intro { max-width: none; }
  }
</style>
