---
import { site } from '../content/site';
import { asset } from '../lib/asset';
const { hero } = site;
---

<section id="top" class="hero section" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <span class="eyebrow">{hero.eyebrow}</span>
      <h1 id="hero-title" class="hero-title">
        <span class="hero-line">{hero.headlineTop}</span>
        <span class="hero-line hero-line--accent">{hero.headlineAccent}</span>
      </h1>
      <p class="hero-intro">{hero.intro}</p>

      <ul class="hero-meta">
        {hero.meta.map((item) => <li>{item}</li>)}
      </ul>

      <div class="hero-actions">
        <a class="btn btn-primary btn-lg" href={hero.ctaHref}>{hero.ctaLabel}</a>
      </div>
    </div>

    <figure class="hero-figure">
      <img
        src={asset(hero.image.src)}
        alt={hero.image.alt}
        width="1200"
        height="900"
        fetchpriority="high"
        decoding="async"
      />
    </figure>
  </div>
</section>

<style>
  .hero { padding-top: clamp(2.5rem, 1.5rem + 4vw, 5rem); }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.02fr 0.98fr;
    align-items: center;
    gap: clamp(2rem, 1rem + 5vw, 5.5rem);
  }
  .hero-title {
    font-size: var(--step-4);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.03em;
    margin: 1.1rem 0 1.4rem;
  }
  .hero-line { display: block; }
  .hero-line--accent { color: var(--olive-deep); }
  .hero-intro {
    font-size: var(--step-1);
    color: var(--ink-soft);
    max-width: 44ch;
    line-height: 1.7;
  }

  /* Quiet typographic meta line (not filled badges) */
  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.85rem;
    margin-top: 1.6rem;
    color: var(--ink-mute);
    font-size: var(--step--1);
    font-weight: 500;
  }
  .hero-meta li { position: relative; }
  .hero-meta li + li::before {
    content: '';
    position: absolute;
    inset-inline-end: -0.52rem;
    top: 50%;
    width: 3px; height: 3px;
    border-radius: 50%;
    background: var(--olive);
    transform: translateY(-50%);
  }

  .hero-actions { margin-top: 2.2rem; }

  .hero-figure { margin: 0; }
  .hero-figure img {
    width: 100%;
    aspect-ratio: 4 / 3;      /* matches the 1200x900 source — full scene, no crop */
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }

  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-figure { order: -1; max-width: 560px; margin-inline: auto; }
    .hero-title { margin-top: 0.8rem; }
    .hero-intro { max-width: none; }
  }
</style>
