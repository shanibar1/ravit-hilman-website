---
import { site } from '../content/site';
const { faq } = site;
---

<section id="faq" class="faq section" aria-labelledby="faq-title">
  <div class="wrap faq-grid">
    <div class="faq-head reveal">
      <h2 id="faq-title" class="section-heading">{faq.heading}</h2>
    </div>

    <div class="faq-list">
      {faq.items.map((item) => (
        <details class="faq-item reveal" name="faq">
          <summary>
            <span class="faq-q">{item.question}</span>
            <span class="faq-icon" aria-hidden="true"></span>
          </summary>
          <div class="faq-a"><p>{item.answer}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-grid {
    display: grid;
    grid-template-columns: 0.7fr 1.3fr;
    gap: clamp(1.6rem, 1rem + 3vw, 4rem);
    align-items: start;
  }
  .faq-head { position: sticky; top: 6rem; }

  .faq-list { display: grid; gap: 0.8rem; }
  .faq-item {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--ivory-soft);
    overflow: hidden;
  }
  .faq-item[open] { border-color: var(--olive); }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.3rem;
    cursor: pointer;
    min-height: 56px;
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  .faq-q { font-family: var(--font-display); font-size: var(--step-1); color: var(--ink); }
  .faq-icon {
    flex: 0 0 auto;
    position: relative;
    width: 20px; height: 20px;
  }
  .faq-icon::before, .faq-icon::after {
    content: '';
    position: absolute;
    background: var(--olive);
    transition: transform 300ms ease, opacity 300ms ease;
  }
  .faq-icon::before { inset-block: 0; inset-inline-start: 9px; width: 2px; }
  .faq-icon::after { inset-inline: 0; top: 9px; height: 2px; }
  .faq-item[open] .faq-icon::before { transform: scaleY(0); opacity: 0; }

  .faq-a { padding: 0 1.3rem 1.2rem; }
  .faq-a p { color: var(--ink-soft); max-width: 62ch; }

  @media (max-width: 760px) {
    .faq-grid { grid-template-columns: 1fr; }
    .faq-head { position: static; }
  }
</style>
